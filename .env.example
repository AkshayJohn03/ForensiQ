# ForensiQ configuration (all optional — everything runs offline without keys).
# Copy to .env and fill in only what you need. Prefix: FORENSIQ_.

# --- Classifier thresholds (rules-first pass) ---
# Retrieve-stage hit scores below this count as weak context (F-RET-002).
#FORENSIQ_LOW_SCORE_THRESHOLD=0.5
# Total trace cost above cohort p95 * factor counts as a cost spike (F-INFRA-002).
#FORENSIQ_COST_SPIKE_FACTOR=3.0

# --- Drift detection ---
#FORENSIQ_ALPHA=0.01
#FORENSIQ_BASELINE_DAYS=14
#FORENSIQ_WINDOW_DAYS=3

# --- Optional LLM second pass (pass 2 on ambiguous failures) ---
# Any OpenAI-compatible /chat/completions endpoint works (OpenAI, vLLM, Ollama...).
# When unset or FORENSIQ_LLM_ENABLED=false, the deterministic EchoMockClient
# fallback classifies ambiguous traces offline.
#FORENSIQ_LLM_ENABLED=false
#FORENSIQ_LLM_BASE_URL=https://api.openai.com/v1
#FORENSIQ_LLM_API_KEY=sk-...
#FORENSIQ_LLM_MODEL=gpt-4o-mini

# --- Langfuse ingestion (forensiq ingest --langfuse) ---
# Pulled via plain httpx REST calls; the loader refuses to run without keys.
#LANGFUSE_HOST=https://cloud.langfuse.com
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...

# ── Trace receiver (optional extra: pip install 'forensiq[serve]') ──────────
# Comma-separated RAW keys for the X-ForensiQ-Key header. Only SHA-256 hashes
# are stored/compared. UNSET = auth disabled (open receiver, dev mode).
#FORENSIQ_API_KEYS=change-me-local-key,another-key
